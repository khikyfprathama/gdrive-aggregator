                "avatar_url": {
                    "type": "string",
                    "example": "https://..."
                },
                "display_name": {
                    "type": "string",
                    "example": "John Doe"
                },
                "email": {
                    "type": "string",
                    "example": "user@gmail.com"
                },
                "free_storage": {
                    "type": "integer",
                    "example": 10737418240
                },
                "free_storage_str": {
                    "type": "string",
                    "example": "10.00 GB"
                },
                "id": {
                    "type": "integer",
                    "example": 1
                },
                "is_active": {
                    "type": "boolean",
                    "example": true
                },
                "storage_limit": {
                    "type": "integer",
                    "example": 16106127360
                },
                "storage_limit_str": {
                    "type": "string",
                    "example": "15.00 GB"
                },
                "storage_usage": {
                    "type": "integer",
                    "example": 5368709120
                },
                "storage_usage_str": {
                    "type": "string",
                    "example": "5.00 GB"
                },
                "usage_percent": {
                    "type": "number",
                    "example": 33.33
                }
