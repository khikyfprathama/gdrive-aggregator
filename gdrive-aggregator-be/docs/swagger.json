        },
        "model.AuthURLResponse": {
            "type": "object",
            "properties": {
                "auth_url": {
                    "type": "string",
                    "example": "https://accounts.google.com/o/oauth2/auth?..."
                }
            }
        },
        "model.BaseResponse": {
            "type": "object",
            "properties": {
                "data": {},
                "message": {
                    "type": "string",
                    "example": "Operation successful"
                },
                "success": {
                    "type": "boolean",
                    "example": true
                }
            }
        },
        "model.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "detail error"
                },
                "message": {
                    "type": "string",
                    "example": "Terjadi kesalahan"
                },
                "success": {
                    "type": "boolean",
                    "example": false
                }
            }
        },
        "model.FileRecord": {
            "type": "object",
            "properties": {
                "account_email": {
                    "type": "string"
                },
                "account_id": {
                    "type": "integer"
                },
                "created_at": {
                    "type": "string"
                },
                "drive_file_id": {
                    "type": "string"
                },
                "icon_link": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "is_folder": {
                    "type": "boolean"
                },
                "md5_checksum": {
                    "type": "string"
                },
                "mime_type": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "parent_id": {
                    "type": "string"
                },
                "size": {
                    "description": "bytes",
                    "type": "integer"
                },
                "updated_at": {
                    "type": "string"
                },
                "web_view_link": {
                    "type": "string"
                }
            }
        },
        "model.FileUploadResponseDTO": {
            "type": "object",
            "properties": {
                "account_email": {
                    "type": "string",
                    "example": "user@gmail.com"
                },
                "account_id": {
                    "type": "integer",
                    "example": 1
                },
                "drive_file_id": {
                    "type": "string",
                    "example": "1a2b3c4d..."
                },
                "file_id": {
                    "type": "integer",
                    "example": 1
                },
                "mime_type": {
                    "type": "string",
