                },
                "total_limit_bytes": {
                    "type": "integer",
                    "example": 32212254720
                },
                "total_limit_human": {
                    "type": "string",
                    "example": "30.00 GB"
                },
                "total_usage_bytes": {
                    "type": "integer",
                    "example": 10737418240
                },
                "total_usage_human": {
                    "type": "string",
                    "example": "10.00 GB"
                },
                "usage_percentage": {
                    "type": "number",
                    "example": 33.33
                }
            }
